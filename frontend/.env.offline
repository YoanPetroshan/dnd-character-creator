# Offline build: the engine runs in the browser (Pyodide in a Web Worker) when the pack is served and WebAssembly works.
# Used by `npm run build:offline` and `npm run dev:offline` (vite --mode offline). The default mode talks to the Flask server.
VITE_OFFLINE_ENGINE=1
# The service worker (O4) precaches the whole pack, the PDF stack included, so the PDF stack loads right after boot and
# the first PDF is instant and works offline. (`lazy` loads it on the first PDF export instead.)
VITE_OFFLINE_PDF=eager
# Not set here, set by the build that needs it:
#   VITE_BASE=/dnd-character-creator/   public sub-path (GitHub Pages); default "/"
#   VITE_SERVERLESS=1                    static host with no Flask server: an engine that cannot run is reported, not retried on /api
