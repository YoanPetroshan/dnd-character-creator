{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "backend",
      "runtimeExecutable": ".venv/bin/flask",
      "runtimeArgs": [
        "--app",
        "server/app.py",
        "run",
        "--port",
        "8000"
      ],
      "port": 8000
    }
  ]
}